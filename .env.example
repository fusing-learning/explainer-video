# Copy to .env and fill in. .env is gitignored.

# Required for the voice-over (Gemini TTS). https://aistudio.google.com/apikey
# Without it the narration falls back to macOS `say`.
GEMINI_API_KEY=

# Needed for unattended ./explain and the text summary. Not needed when you
# make videos from a Claude Code session. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: Gemini TTS requests per minute. Set to one under your tier's limit.
# GEMINI_TTS_RPM=9
