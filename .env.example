# Copy to .env and fill in. .env is gitignored.

# Required for the voice-over (Gemini TTS). https://aistudio.google.com/apikey
# Without it the narration falls back to macOS `say`.
GEMINI_API_KEY=

# Optional. Unattended ./explain and the text summary run through `claude -p`
# on your Claude Code login; the key is used when the claude CLI is missing or
# fails. https://console.anthropic.com
ANTHROPIC_API_KEY=

# Optional: "api" to always use ANTHROPIC_API_KEY, "cli" to always use claude -p.
# CLAUDE_BACKEND=

# Optional: Gemini TTS requests per minute. Set to one under your tier's limit.
# GEMINI_TTS_RPM=9
